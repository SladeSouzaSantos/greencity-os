# Copie este arquivo para .env e configure a chave da sua conta OpenRouter.
# NUNCA publique o .env. No Flutter Desktop/APK os assets podem ser extraídos.
# Para distribuição pública, mova a chamada ao OpenRouter para um backend.
OPENROUTER_API_KEY=
# ID de um modelo disponível em https://openrouter.ai/models (configurável).
# OpenRouter é o gateway: este exemplo ainda seleciona um modelo Google.
OPENROUTER_MODEL=google/gemini-3.8-flash
# cloudflare-ai: extrai PDF em texto/markdown sem custo adicional de OCR;
# native: exige modelo com suporte nativo a PDF;
# mistral-ocr: extração mais avançada e potencialmente cobrada por página.
OPENROUTER_PDF_ENGINE=cloudflare-ai
