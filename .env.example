# Copie para .env e preencha com sua nova chave OpenRouter LOCAL.
# NUNCA commite .env. Assets Flutter são extraíveis; em produção use backend.
OPENROUTER_API_KEY=
# Apenas modelos :free são permitidos nesta integração.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Modelos gratuitos em ordem de prioridade após o principal.
# Separar por vírgula, sem aspas. Defina vazio para desligar fallback.
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free
# Leitor gratuito de PDF. "native" também é permitido se suportado.
# OCR pago (mistral-ocr) é intencionalmente bloqueado.
OPENROUTER_PDF_ENGINE=cloudflare-ai

# Modo de TESTES local (Windows): true=Ollama, false=OpenRouter.
# Quando true, a chave do OpenRouter NÃO é consultada.
OLLAMA_ENABLED=false
# O modelo abaixo precisa aparecer em "ollama list".
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Contexto de inferência. Ajuste conforme a RAM/VRAM disponível.
OLLAMA_NUM_CTX=4096
# Máximo para aguardar resposta completa da IA local (30..3600 segundos).
# Diferente do timeout de conexão (10 s). Padrão: 900 s.
OLLAMA_RECEIVE_TIMEOUT_SECONDS=900
# Executável Python local que tenha PyMuPDF instalado.
OLLAMA_PYTHON=python

# Roteamento multicloud: auto (prioridade abaixo), ollama ou openrouter.
# Se AI_PROVIDER estiver definido, tem prioridade sobre OLLAMA_ENABLED.
AI_PROVIDER=auto
# false desativa a troca automática de provedor depois de falha/cota.
AI_CLOUD_FALLBACK_ENABLED=true
# Limite por requisição remota, em segundos (30..900).
AI_CLOUD_TIMEOUT_SECONDS=180

# Configure apenas provedores com conta/chave próprias, cota gratuita habilitada.
# Sem chave, o provedor é ignorado e registrado como sem_credencial.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
