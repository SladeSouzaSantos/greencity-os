# Copie este arquivo para .env e informe sua chave localmente.
# ATENÇÃO: .env empacotado no Flutter NÃO protege segredos contra extração do APK.
# Para distribuição pública, use um backend para acessar a API Gemini.
GEMINI_API_KEY=
# Modelo configurável. O gemini-1.5-flash foi desativado em 2025.
GEMINI_MODEL=gemini-3.8-flash
